{
  "name": "harness-acp-bridge-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bridge ACP harnesses (codebuddy/agy/codex) to an MCP client with an asynchronous per-session message queue.",
  "license": "MIT",
  "engines": {
    "node": ">=20.11"
  },
  "bin": {
    "harness-acp-bridge": "dist/cli.js",
    "harness-acp-bridge-daemon": "dist/daemon/main.js"
  },
  "files": [
    "dist",
    "config.example.yaml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.2",
    "yaml": "^2.6.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
