{
  "name": "@black942026/harness-acp-bridge-server",
  "version": "0.1.1",
  "type": "module",
  "description": "HTTP server for session-scoped ACP harness communication, lossless journaling, and live previews.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/black-94/harness-acp-bridge-server.git"
  },
  "homepage": "https://github.com/black-94/harness-acp-bridge-server#readme",
  "bugs": {
    "url": "https://github.com/black-94/harness-acp-bridge-server/issues"
  },
  "keywords": [
    "acp",
    "harness",
    "bridge",
    "codebuddy",
    "codex",
    "http",
    "server"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "files": [
    "dist",
    "config.example.yaml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run clean && npm run build && npm run typecheck && npm test",
    "prepack": "npm run clean && npm run build",
    "prepublishOnly": "npm run check",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "yaml": "^2.6.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  },
  "exports": {
    ".": "./dist/index.js"
  }
}
